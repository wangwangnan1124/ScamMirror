{
  "name": "scam-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "A privacy-first, explainable anti-scam assistant that runs in the browser.",
  "homepage": "https://scammirror-20260726.chilinzhang112.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangwangnan1124/ScamMirror.git"
  },
  "bugs": {
    "url": "https://github.com/wangwangnan1124/ScamMirror/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "eval": "node --experimental-strip-types scripts/evaluate-rules.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "pnpm lint && pnpm test && pnpm eval"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.3.0",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
